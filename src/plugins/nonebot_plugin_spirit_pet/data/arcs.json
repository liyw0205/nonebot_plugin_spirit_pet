              "items": {
                "bloodline_essence": {
                  "minimum": 1,
                  "maximum": 1
                }
              }
            }
          },
          {
            "id": "silence",
            "label": "沉默",
            "text": "你没有回答，只把灯芯挑亮了一寸。",
            "reward": {
              "exp": {
                "minimum": 140,
                "maximum": 140
