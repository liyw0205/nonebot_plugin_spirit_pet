[
  {
    "id": "wind_road",
    "name": "风起青萍",
    "order": 1,
    "description": "山门初雪，一件小事牵出你与一只灵宠的第一次同行。",
    "requires": null,
    "min_realm": "qiling",
    "chapters": [
      {
        "order": 1,
        "title": "山门初雪",
        "text": "雪落山门，一名杂役抱着柴薪滑倒在石阶上，怀里的灵宠跟着摔进雪里。",
        "options": [
          {
            "id": "help",
            "label": "相助",
            "text": "你扶起杂役，也把那只见人的小家伙拢进袖中暖着。",
            "reward": {
              "exp": {
                "minimum": 40,
                "maximum": 40
              },
              "stones": {
                "minimum": 80,
                "maximum": 80
              },
              "items": {
                "spirit_food": {
                  "minimum": 1,
                  "maximum": 1
                }
              }
            }
          },
          {
            "id": "watch",
            "label": "旁观",
            "text": "你站在廊下看他们把柴薪一根根拾回，记住了这份沉默。",
            "reward": {
              "exp": {
                "minimum": 60,
                "maximum": 60
